FLASK_ENV=development

# Gere um valor aleatorio forte. Esta chave protege a sessao do Flask.
SECRET_KEY=
DATABASE_PATH=instance/pixtapago.db

# A aplicacao opera exclusivamente contra a homologacao do Banco do Brasil.
BB_PIX_MODE=bb

# Credenciais de teste exibidas no Portal Developers BB. Nunca versione os valores reais.
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_GW_DEV_APP_KEY=

# Chave disponibilizada pelo BB para a API Pix v2 em homologacao.
BB_PIX_KEY=hmtestes2@bb.com.br

BB_OAUTH_URL=https://oauth.hm.bb.com.br/oauth/token
BB_PIX_BASE_URL=https://api.hm.bb.com.br/pix/v2

# Deixe vazios na homologacao acima. O host mTLS de producao exige os dois arquivos.
BB_MTLS_CERT_PATH=
BB_MTLS_KEY_PATH=

# Segredo exigido no webhook (cabecalho X-Webhook-Secret ou ?token=).
# Sem ele o webhook recusa todas as chamadas. Gere um valor aleatorio forte.
BB_WEBHOOK_SECRET=

# registrationAccessToken nao cria nem consulta cobrancas Pix.
# O Basic e formado em tempo de execucao a partir de client_id e client_secret.
